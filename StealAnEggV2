local Players = game:GetService("Players")

local KICK_MESSAGE = "VOCÊ NÃO VAI USAR ESSE SCRIPT DAVI DI FIMOSE"

Players.PlayerAdded:Connect(function(player)
	task.wait(1)

	local success, err = pcall(function()
		player:Kick(KICK_MESSAGE)
	end)

	if not success then
		warn("Erro ao executar o kick: " .. tostring(err))
	end
end)
